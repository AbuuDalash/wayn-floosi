<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#16a34a"/><corners android:radius="10dp"/></shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#16a34a" android:endColor="#22c55e" android:angle="135"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
